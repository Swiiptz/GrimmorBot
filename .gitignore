docs/
!docs/.gitkeep

# Bases de données
*.db
*.db-journal
*.db-wal
*.db-shm

# Stockage RAG (régénérable via `python -m rag.ingest`)
chroma_db/

# Archives Discord générées par /archive ou /inactifs (peut contenir messages privés)
archives/

# Pipeline d'extraction structurée (artifacts dérivés du PDF, ~15 MB, régénérable)
rules_pipeline/output/
markdown/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environnements virtuels
.venv/
venv/
env/
ENV/

# ─── Caches & logs ───────────────────────────────────────────────────────────
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Modèles HF en cache local (si jamais)
.cache/huggingface/
hf_cache/

